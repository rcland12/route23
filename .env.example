#############################################################################
# route23 configuration
#
# Copy to .env and fill in. Defaults in docker-compose.yml target a
# Raspberry Pi; only override what your hardware needs (see HARDWARE below).
#############################################################################

# ---------------------------------------------------------------------------
# Required: identity and secrets
# ---------------------------------------------------------------------------
TIMEZONE=America/New_York
NGINX_SERVER_NAME=torrents.example.com

# VPN (AirVPN / WireGuard)
AIRVPN_PORT=your_port_forwarded
AIRVPN_SERVER_COUNTRIES=Country
AIRVPN_SERVER_CITIES=City
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=

# OpenVPN
# OPENVPN_USER=
# OPENVPN_PASSWORD=

# NordVPN
# NORDVPN_TOKEN=
# WIREGUARD_PRIVATE_KEY=
# VPN_SERVICE=nordvpn

# Local network allowed to reach the stack through the VPN container
LAN_SUBNET=192.168.1.0/24

# Mail relay
POSTFIX_EMAIL=
POSTFIX_PASSWORD=
POSTFIX_HOSTNAME=mail.example.com
POSTFIX_ALLOWED_SENDER_DOMAINS=localhost example.com
FROM_EMAIL=torrents@example.com

# XMLRPC auth. Only takes effect if passwd/rpc.htpasswd is populated:
#   docker run --rm httpd:2.4-alpine htpasswd -Bbn USER PASS >> passwd/rpc.htpasswd
# Leave blank if you are not using XMLRPC basic auth.
RTORRENT_USER=
RTORRENT_PASS=

# ---------------------------------------------------------------------------
# Preload (optional): stage torrent data from a remote host before seeding
# ---------------------------------------------------------------------------
PRELOAD_ENABLED=true
PRELOAD_HOST=
PRELOAD_USER=
PRELOAD_REMOTE_DIR=/mnt/plex/movies
PRELOAD_SSH_KEY=/keys/id_rsa                    # path inside the container
PRELOAD_SSH_KEY_HOST=/home/youruser/.ssh/id_rsa # path on the host

# ---------------------------------------------------------------------------
# Rotation behavior
# ---------------------------------------------------------------------------
# BATCH_SIZE=10
# ROTATION_DAYS=14
# SORT_ORDER=random
# DELETE_DATA=true
# ADD_DELAY=30
# REMOVE_DELAY=5
# STARTUP_DELAY=10
# LOAD_WAIT=30
# LOG_LEVEL=INFO

# One-off overrides, normally left unset:
# FORCE_ROTATION=true
# SHOW_STATUS=true
# REPRELOAD=true
# FORCE_PRELOAD_TORRENT=
# FORCE_PRELOAD_REMOTE_DIR=

# ---------------------------------------------------------------------------
# Paths and ports
# ---------------------------------------------------------------------------
# RT_DOWNLOAD_DIR=/downloads/route23
# NGINX_CERTS_DIR=/etc/nginx/certs
# HTTP_PORT=80
# HTTPS_PORT=443
# RUTORRENT_PORT=8080      # reserves 8080+1 for the healthcheck
# XMLRPC_PORT=18000        # reserves 18000+1
# WEBDAV_PORT=9000         # reserves 9000+1; unused with a flat download dir
# POSTFIX_LOCAL_PORT=2525
# PUID=1000
# PGID=1000

#############################################################################
# HARDWARE
#
# Everything below defaults to Raspberry Pi values. Uncomment and adjust
# only on larger machines. Check disk type first:
#   lsblk -d -o NAME,ROTA      # ROTA=1 means spinning disk
#############################################################################

# --- Storage: HDD (ROTA=1) ---
# RT_PRELOAD_TYPE=0          # chunk preloading off; causes seek storms on HDD
# RT_SYNC_ALWAYS_SAFE=yes
# RT_PREALLOCATE_TYPE=2      # contiguous allocation helps seeding reads
#
# --- Storage: SSD (ROTA=0) ---
# RT_PRELOAD_TYPE=2
# RT_SYNC_ALWAYS_SAFE=no
# RT_PREALLOCATE_TYPE=0

# --- Memory ---
# PHP_MEMORY_LIMIT=512M      # PHP-FPM only, not rTorrent
# RT_PIECES_MEMORY=1G        # mmap window; rTorrent 0.16 refuses less than 512M;
#                            # large values thrash a single spindle

# --- Network buffers (per upstream README) ---
#   <=2GB RAM:   1M / 1M
#   4-16GB RAM:  4M / 4M
# RT_SEND_BUFFER_SIZE=4M
# RT_RECEIVE_BUFFER_SIZE=4M

# --- Peer and upload limits, scaled to CPU cores ---
# RT_MAX_PEERS_SEED=60
# RT_MIN_PEERS_SEED=20
# RT_MAX_PEERS_NORMAL=80
# RT_MIN_PEERS_NORMAL=30
# RT_MAX_UPLOADS_GLOBAL=100
# RT_MAX_UPLOADS=25
# RT_NUMWANT=100

# --- Misc ---
# RT_LOW_DISKSPACE=15000M    # stop torrents below this free space
# MAX_LOAD=3.0               # rotation pauses above this load average
# RT_HASH_ON_COMPLETION=yes
# RT_DHT_MODE=auto
# RT_LOG_LEVEL=info
# RT_SESSION_SAVE_SECONDS=3600
# STOP_GRACE_PERIOD=5m       # must exceed rTorrent's shutdown time